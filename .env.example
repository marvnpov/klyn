# GEMINI_API_KEY: Required for server-side Gemini AI Wrapped & recommendation endpoints.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_YOUTUBE_API_KEY: Optional YouTube Data API v3 key for resolving full-length official audio tracks and pagination.
VITE_YOUTUBE_API_KEY="MY_YOUTUBE_DATA_API_V3_KEY"

# Spotify Web API: Client ID for frontend detection and Client Secret for server-side /api/spotify/token proxy.
VITE_SPOTIFY_CLIENT_ID="MY_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="MY_SPOTIFY_CLIENT_SECRET"

# Firebase Web SDK configuration (custom external project overrides; targets (default) Firestore database when VITE_FIREBASE_DATABASE_ID is omitted)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
