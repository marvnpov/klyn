{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated listener profile, connected streaming apps, preferences, liked/followed IDs, and bounded listening stats.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Display name" },
        "handle": { "type": "string", "description": "Listener handle starting with @" },
        "email": { "type": "string", "description": "Verified account email" },
        "initials": { "type": "string", "description": "Avatar monogram initials" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL or compressed data URI" },
        "avatarStyle": { "type": "string", "enum": ["monogram", "obsidian-ring", "glass-emblem", "halo"] },
        "accentColor": { "type": "string", "description": "Hex accent color" },
        "favoriteGenres": { "type": "array", "items": { "type": "string" } },
        "likedTrackIds": { "type": "array", "items": { "type": "string" } },
        "followedArtistIds": { "type": "array", "items": { "type": "string" } },
        "downloadedTrackIds": { "type": "array", "items": { "type": "string" } },
        "recentSearches": { "type": "array", "items": { "type": "string" } },
        "activeDeviceId": { "type": "string" },
        "hasCompletedOnboarding": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "connectedApps": { "type": "object" },
        "preferences": { "type": "object" },
        "likedSongsCustomization": { "type": "object" },
        "listeningStats": { "type": "object" },
        "showProgress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "handle", "email", "initials", "hasCompletedOnboarding", "createdAt", "updatedAt"]
    },
    "UserPlaylist": {
      "title": "UserPlaylist",
      "description": "User-created, imported, or Klyn AI Blend playlist owned by a single listener.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "curator": { "type": "string" },
        "description": { "type": "string" },
        "trackIds": { "type": "array", "items": { "type": "string" } },
        "coverUrl": { "type": "string" },
        "pinned": { "type": "boolean" },
        "downloaded": { "type": "boolean" },
        "accentGradient": { "type": "string" },
        "displayMode": { "type": "string", "enum": ["comfortable", "compact"] },
        "showQualityBadges": { "type": "boolean" },
        "isAiBlend": { "type": "boolean" },
        "blendMatchPct": { "type": "number" },
        "sharedWithFriendId": { "type": "string" },
        "sourceProvider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "trackIds", "createdAt", "updatedAt"]
    },
    "DownloadedTrack": {
      "title": "DownloadedTrack",
      "description": "Offline-saved track metadata synchronized to the listener's App Downloads.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "album": { "type": "string" },
        "duration": { "type": "number" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "genre": { "type": "string" },
        "category": { "type": "string", "enum": ["Music", "Mixes"] },
        "quality": { "type": "string", "enum": ["Hi-Res Lossless", "Lossless"] },
        "coverUrl": { "type": "string" },
        "fallbackGradient": { "type": "string" },
        "playlistName": { "type": "string" },
        "year": { "type": "number" },
        "youtubeId": { "type": "string" },
        "downloadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "artist", "album", "duration", "downloadedAt"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Active device session and battery telemetry for cross-device handoff and power monitoring.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "platform": { "type": "string" },
        "isPlaying": { "type": "boolean" },
        "activeTrackId": { "type": "string" },
        "activeTrackTitle": { "type": "string" },
        "activeTrackArtist": { "type": "string" },
        "playbackPosition": { "type": "number" },
        "batteryLevel": { "type": "number" },
        "batteryCharging": { "type": "boolean" },
        "bluetoothDeviceName": { "type": "string" },
        "bluetoothBatteryLevel": { "type": "number" },
        "lastSeen": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "ownerId", "name", "isPlaying", "lastSeen", "updatedAt"]
    },
    "UserFriend": {
      "title": "UserFriend",
      "description": "Friend connection saved for Blend and Listen Party sessions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "initials": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "isFriend": { "type": "boolean" },
        "tasteMatchPct": { "type": "number" },
        "accentColor": { "type": "string" },
        "lastActiveLabel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "handle", "initials", "isFriend", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Discoverable listener profile card by handle/uid for social friend discovery.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "initials": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "accentColor": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "handle", "initials", "updatedAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Real user friend, Blend, or Listen Party request between authenticated KLYN listeners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fromUid": { "type": "string" },
        "fromName": { "type": "string" },
        "fromHandle": { "type": "string" },
        "toUid": { "type": "string" },
        "kind": { "type": "string", "enum": ["friend", "blend", "listen-party"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "trackId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUid", "fromName", "fromHandle", "toUid", "kind", "status", "createdAt", "updatedAt"]
    },
    "ListenParty": {
      "title": "ListenParty",
      "description": "Synced Listen Party playback session shared between two authenticated KLYN listeners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hostUid": { "type": "string" },
        "guestUid": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "activeTrackId": { "type": "string" },
        "activeTrackTitle": { "type": "string" },
        "activeTrackArtist": { "type": "string" },
        "isPlaying": { "type": "boolean" },
        "messages": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "hostUid", "guestUid", "status", "isPlaying", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Listener profile, customization, settings, connected apps, and library indices."
    },
    "/users/{userId}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/UserPlaylist" },
      "description": "Listener's personal, imported, and AI Blend playlists."
    },
    "/users/{userId}/downloads/{trackId}": {
      "schema": { "$ref": "#/entities/DownloadedTrack" },
      "description": "Offline App Downloads synchronized for the listener."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/UserDevice" },
      "description": "Connected device playback handoff and live battery status records."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": { "$ref": "#/entities/UserFriend" },
      "description": "Listener's saved social friends for Listen Party and Blend."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public handle lookup card for friend search and requests."
    },
    "/friend_requests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Peer-to-peer friend, Blend, and Listen Party requests."
    },
    "/listen_parties/{partyId}": {
      "schema": { "$ref": "#/entities/ListenParty" },
      "description": "Synced Listen Party sessions between two listeners."
    }
  }
}
